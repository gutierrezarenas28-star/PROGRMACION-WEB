              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/productos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "productos"
              ]
            }
          },
          "response": []
        },
        {
          "name": "DELETE producto SIN token (debe dar 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('401 Token requerido', () => {",
                  "  pm.response.to.have.status(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
