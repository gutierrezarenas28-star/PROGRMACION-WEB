              ]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/productos/{{productoIdPrueba}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "productos",
                "{{productoIdPrueba}}"
              ]
            },
            "description": "Token válido, pero rol usuario. El producto NO se borra."
          },
          "response": []
